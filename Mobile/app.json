{
  "expo": {
    "name": "INHALEX",
    "slug": "inhalex-movil",
    "version": "0.1.0",
    "platforms": ["android", "web"],
    "scheme": "inhalex",
    "orientation": "portrait",
    "icon": "./assets/inhalex-mark.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.inhalex.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF5",
        "foregroundImage": "./assets/inhalex-mark.png",
        "monochromeImage": "./assets/inhalex-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF5",
          "image": "./assets/NuevoLogo.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": false } }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
