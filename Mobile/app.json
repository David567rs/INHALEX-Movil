{
  "expo": {
    "name": "INHALEX",
    "slug": "inhalex-movil",
    "version": "1.0.0-rc.2",
    "platforms": ["android", "web"],
    "scheme": "inhalex",
    "orientation": "portrait",
    "icon": "./assets/inhalex-mark.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.inhalex.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF5",
        "foregroundImage": "./assets/inhalex-mark.png",
        "monochromeImage": "./assets/inhalex-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF5",
          "image": "./assets/NuevoLogo.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": false } }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": {
        "projectId": "1f3cb8fd-fa19-42ae-b1e1-22e7fcad793a"
      }
    },
    "owner": "david567"
  }
}
